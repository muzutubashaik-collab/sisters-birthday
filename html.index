<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>A Special Surprise For Foujia 💖🎂</title>

<!-- BEAUTIFUL FONTS -->
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Dancing+Script:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Pacifico&display=swap" rel="stylesheet">

<style>

/* RESET */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#070018;
    color:white;
    overflow-x:hidden;
}

/* STAR BACKGROUND */
#stars{
    position:fixed;
    inset:0;
    z-index:-1;
    overflow:hidden;
}

.star{
    position:absolute;
    width:4px;
    height:4px;
    background:white;
    border-radius:50%;
    box-shadow:0 0 10px white;
    animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
    from{
        opacity:0.2;
        transform:scale(0.6);
    }

    to{
        opacity:1;
        transform:scale(1.5);
    }
}

/* INTRO */
#intro{
    position:fixed;
    inset:0;
    z-index:1000;

    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;

    text-align:center;

    background:radial-gradient(
        circle at center,
        #6a0dad,
        #210040,
        #070018
    );
}

.intro-heart{
    font-size:100px;
    animation:heartBeat 1.5s infinite;
}

@keyframes heartBeat{
    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.2);
    }
}

.intro-title{
    font-family:'Great Vibes',cursive;
    font-size:clamp(60px,12vw,140px);
    margin:20px;

    text-shadow:
        0 0 20px #ff69b4,
        0 0 60px #ff1493;
}

.intro-text{
    font-family:'Dancing Script',cursive;
    font-size:clamp(25px,5vw,40px);
    margin:20px;
}

/* BUTTON */
button{
    border:none;
    padding:16px 35px;
    border-radius:50px;

    font-family:'Poppins',sans-serif;
    font-size:17px;
    font-weight:bold;

    color:white;
    cursor:pointer;

    background:linear-gradient(
        45deg,
        #ff006e,
        #ff8c00,
        #ffd700,
        #ff006e
    );

    background-size:300%;
    animation:buttonColor 4s infinite;

    box-shadow:0 10px 30px rgba(0,0,0,0.4);
    transition:0.4s;
}

@keyframes buttonColor{
    0%{
        background-position:0%;
    }

    100%{
        background-position:300%;
    }
}

button:hover{
    transform:scale(1.1);

    box-shadow:
        0 0 25px white,
        0 0 60px #ff1493;
}

/* GIFT SCREEN */
#giftScreen{
    display:none;
    position:fixed;
    inset:0;
    z-index:900;

    background:radial-gradient(
        circle,
        #ff1493,
        #6a0dad,
        #10002b
    );

    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
}

.gift{
    font-size:180px;
    cursor:pointer;
    animation:giftShake 1s infinite;
}

@keyframes giftShake{
    0%,100%{
        transform:rotate(0deg);
    }

    25%{
        transform:rotate(-8deg);
    }

    75%{
        transform:rotate(8deg);
    }
}

.gift-text{
    font-family:'Pacifico',cursive;
    font-size:28px;
    margin-top:20px;
}

/* COUNTDOWN */
#countdownScreen{
    display:none;

    position:fixed;
    inset:0;

    z-index:850;

    justify-content:center;
    align-items:center;

    background:#05000d;
}

#countdown{
    font-family:'Pacifico',cursive;
    font-size:200px;
    animation:pulse 1s infinite;
    color:#ffd700;
}

@keyframes pulse{
    0%{
        transform:scale(0.4);
        opacity:0;
    }

    50%{
        transform:scale(1.3);
        opacity:1;
    }

    100%{
        transform:scale(0.4);
        opacity:0;
    }
}

/* SLIDESHOW */
#slideshow{
    display:none;

    position:fixed;
    inset:0;

    z-index:800;
    background:black;
}

.slide{
    position:absolute;
    inset:0;

    opacity:0;
    transition:opacity 2s ease;
}

.slide.active{
    opacity:1;
}

.slide img{
    width:100%;
    height:100%;

    object-fit:cover;

    animation:zoomPhoto 7s ease forwards;
}

@keyframes zoomPhoto{
    from{
        transform:scale(1);
    }

    to{
        transform:scale(1.15);
    }
}

.slide::after{
    content:"";

    position:absolute;
    inset:0;

    background:linear-gradient(
        to top,
        rgba(0,0,0,0.85),
        rgba(0,0,0,0.05),
        rgba(0,0,0,0.6)
    );
}

.slide-text{
    position:absolute;

    bottom:15%;
    width:100%;

    text-align:center;

    z-index:5;

    font-family:'Great Vibes',cursive;

    font-size:clamp(55px,10vw,120px);

    text-shadow:
        0 0 20px #ff1493,
        0 0 40px black;
}

/* MAIN WEBSITE */
#main{
    display:none;

    min-height:100vh;
    padding:50px 15px;

    background:linear-gradient(
        135deg,
        #ff006e,
        #8338ec,
        #3a86ff,
        #00c6ff,
        #ff006e
    );

    background-size:500%;
    animation:backgroundMove 15s infinite;
}

@keyframes backgroundMove{
    0%{
        background-position:0%;
    }

    50%{
        background-position:100%;
    }

    100%{
        background-position:0%;
    }
}

.card{
    max-width:1000px;
    margin:auto;

    text-align:center;
    padding:50px 25px;

    border-radius:45px;

    background:rgba(255,255,255,0.15);
    backdrop-filter:blur(20px);

    border:1px solid rgba(255,255,255,0.5);

    box-shadow:0 30px 100px rgba(0,0,0,0.5);
}

/* CAKE */
.cake{
    font-size:120px;
    animation:cakeFloat 2s infinite;
}

@keyframes cakeFloat{
    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-20px) rotate(4deg);
    }
}

/* TITLE */
.main-title{
    font-family:'Great Vibes',cursive;

    font-size:clamp(70px,12vw,140px);
    margin:20px;

    color:white;

    text-shadow:
        0 0 20px #ff1493,
        0 0 60px #ffd700;
}

.subtitle{
    font-family:'Dancing Script',cursive;
    font-size:clamp(25px,5vw,40px);
    margin-bottom:30px;
}

/* MESSAGE */
.message{
    font-family:'Playfair Display',serif;

    font-size:20px;
    line-height:2;

    max-width:750px;
    margin:40px auto;
}

/* PHOTO GALLERY */
.memory-title{
    font-family:'Great Vibes',cursive;
    font-size:65px;
    margin:30px;
}

.gallery{
    display:flex;
    flex-wrap:wrap;

    justify-content:center;
    gap:30px;
}

.memory{
    width:300px;
    height:390px;

    padding:8px;
    border-radius:35px;

    background:linear-gradient(
        45deg,
        gold,
        #ff1493,
        #00ffff,
        gold
    );

    background-size:300%;
    animation:borderMove 5s infinite;

    transition:0.5s;

    box-shadow:0 20px 50px rgba(0,0,0,0.4);
}

@keyframes borderMove{
    0%{
        background-position:0%;
    }

    100%{
        background-position:300%;
    }
}

.memory:hover{
    transform:scale(1.08) rotate(3deg);
}

.memory img{
    width:100%;
    height:100%;

    object-fit:cover;
    border-radius:28px;
}

/* LETTER */
#letter{
    display:none;

    margin-top:50px;
    padding:40px;

    border-radius:35px;

    background:linear-gradient(
        135deg,
        rgba(255,255,255,0.25),
        rgba(255,255,255,0.08)
    );

    border:1px solid white;
    animation:letterOpen 1.5s ease;
}

@keyframes letterOpen{
    from{
        opacity:0;
        transform:scale(0.5) rotate(-5deg);
    }

    to{
        opacity:1;
        transform:scale(1) rotate(0);
    }
}

.letter-title{
    font-family:'Great Vibes',cursive;

    font-size:75px;
    color:#ffd700;

    margin-bottom:25px;
}

.letter-text{
    font-family:'Dancing Script',cursive;

    font-size:30px;
    line-height:1.9;
}

/* MUSIC BUTTON */
.music-button{
    position:fixed;

    top:20px;
    left:20px;

    z-index:5000;
}

/* FLOATING HEARTS */
.heart{
    position:fixed;

    z-index:4000;
    pointer-events:none;

    animation:heartFly linear forwards;
}

@keyframes heartFly{
    from{
        transform:translateY(110vh) rotate(0deg);
        opacity:1;
    }

    to{
        transform:translateY(-10vh) rotate(360deg);
        opacity:0;
    }
}

/* MOBILE */
@media(max-width:600px){

    .card{
        padding:35px 15px;
    }

    .memory{
        width:90%;
        max-width:310px;
    }

    .message{
        font-size:17px;
    }

    .letter-text{
        font-size:24px;
    }

    .gift{
        font-size:140px;
    }

    #countdown{
        font-size:140px;
    }
}

</style>
</head>

<body>

<!-- STARS -->
<div id="stars"></div>

<!-- MUSIC -->
<audio id="music" loop>
    <source src="music.mp3" type="audio/mpeg">
</audio>

<button class="music-button" onclick="toggleMusic()">
🎵 Music
</button>

<!-- INTRO -->
<div id="intro">

    <div class="intro-heart">💖</div>

    <h1 class="intro-title">
        Hey Foujia... 💖
    </h1>

    <p class="intro-text">
        I have something very special for you... 🎁✨
    </p>

    <button onclick="openGift()">
        Open My Surprise 💝
    </button>

</div>

<!-- GIFT SCREEN -->
<div id="giftScreen">

    <div class="gift" onclick="startCountdown()">
        🎁
    </div>

    <div class="gift-text">
        Tap the Gift to Open It! 💖
    </div>

</div>

<!-- COUNTDOWN -->
<div id="countdownScreen">
    <div id="countdown">3</div>
</div>

<!-- SLIDESHOW -->
<div id="slideshow">

    <div class="slide active">
        <img src="22474.jpg" alt="Foujia">
        <div class="slide-text">
            Beautiful Foujia 💖
        </div>
    </div>

    <div class="slide">
        <img src="22473.jpg" alt="Foujia">
        <div class="slide-text">
            Beautiful Memories ✨
        </div>
    </div>

</div>

<!-- MAIN PAGE -->
<div id="main">

<div class="card">

    <div class="cake">🎂</div>

    <h1 class="main-title">
        Happy Birthday Foujia!
    </h1>

    <div class="subtitle">
        To The Amazing Foujia 💖✨
    </div>

    <p class="message">

        Today is not just another day... 🎉

        <br><br>

        Today is the day when someone very special came into this beautiful world. 💖

        <br><br>

        Someone who brings happiness, smiles and unforgettable memories into our family. ✨

        <br><br>

        Even though distance separates us today, you are always close to my heart. ❤️

        <br><br>

        This small website is my special birthday gift, made with lots of love especially for you, Foujia. 🎁💝

    </p>

    <h2 class="memory-title">
        Beautiful Memories of Foujia 📸
    </h2>

    <div class="gallery">

        <div class="memory">
            <img src="22474.jpg" alt="Memory">
        </div>

        <div class="memory">
            <img src="22473.jpg" alt="Memory">
        </div>

    </div>

    <br><br>

    <button onclick="openLetter()">
        💌 Open Your Special Birthday Letter
    </button>

    <!-- LETTER -->
    <div id="letter">

        <h2 class="letter-title">
            A Special Letter For Foujia ❤️
        </h2>

        <div class="letter-text">

            Dear Foujia... 🌸

            <br><br>

            You are not just my sister...

            <br>

            You are a beautiful and irreplaceable part of my life. 💖

            <br><br>

            We may laugh together 😂, fight sometimes 😄, and create countless funny memories...

            <br><br>

            But no matter where we are, you will always have a very special place in my heart. ❤️

            <br><br>

            🤲 May Allah always bless you with happiness, peace, success and a beautiful future.

            <br><br>

            May every dream in your heart come true. ✨

            <br><br>

            🎂 HAPPY BIRTHDAY FOUJIA! 🎂

            <br><br>

            💖 Keep Smiling<br>
            ✨ Keep Shining<br>
            🌸 Keep Being Amazing

            <br><br>

            With Lots of Love...

            <br><br>

            ❤️ Your Brother ❤️

        </div>

    </div>

</div>
</div>

<script>

/* CREATE STARS */
for(let i = 0; i < 150; i++){

    const star = document.createElement("div");

    star.className = "star";

    star.style.left = Math.random() * 100 + "vw";
    star.style.top = Math.random() * 100 + "vh";

    star.style.animationDelay = Math.random() * 2 + "s";

    document.getElementById("stars").appendChild(star);
}


/* OPEN GIFT */
function openGift(){

    const music = document.getElementById("music");

    music.volume = 0.7;

    music.play().catch(() => {});

    document.getElementById("intro").style.display = "none";

    document.getElementById("giftScreen").style.display = "flex";
}


/* COUNTDOWN */
function startCountdown(){

    document.getElementById("giftScreen").style.display = "none";

    document.getElementById("countdownScreen").style.display = "flex";

    let number = 3;

    const countdown = document.getElementById("countdown");

    const timer = setInterval(() => {

        number--;

        if(number > 0){

            countdown.innerHTML = number;

        }else{

            clearInterval(timer);

            countdown.innerHTML = "🎉";

            setTimeout(() => {

                document.getElementById("countdownScreen").style.display = "none";

                startSlideshow();

            }, 1000);
        }

    }, 1000);
}


/* SLIDESHOW */
let currentSlide = 0;

const slides = document.querySelectorAll(".slide");

function startSlideshow(){

    document.getElementById("slideshow").style.display = "block";

    currentSlide = 0;

    slides.forEach((slide, index) => {
        slide.classList.toggle("active", index === 0);
    });

    const timer = setInterval(() => {

        slides[currentSlide].classList.remove("active");

        currentSlide++;

        if(currentSlide >= slides.length){

            clearInterval(timer);

            setTimeout(() => {
                finishSlideshow();
            }, 2000);

            return;
        }

        slides[currentSlide].classList.add("active");

    }, 5000);
}


/* FINISH SLIDESHOW */
function finishSlideshow(){

    document.getElementById("slideshow").style.display = "none";

    document.getElementById("main").style.display = "block";

    fireworks();
}


/* OPEN LETTER */
function openLetter(){

    const letter = document.getElementById("letter");

    letter.style.display = "block";

    letter.scrollIntoView({
        behavior:"smooth"
    });

    hearts();
    confetti();
    fireworks();
}


/* HEARTS */
function hearts(){

    for(let i = 0; i < 70; i++){

        setTimeout(() => {

            const heart = document.createElement("div");

            heart.className = "heart";

            const emojis = ["❤️","💖","💕","💗"];

            heart.innerHTML = emojis[Math.floor(Math.random() * emojis.length)];

            heart.style.left = Math.random() * 100 + "vw";

            heart.style.fontSize = (20 + Math.random() * 35) + "px";

            heart.style.animationDuration = (3 + Math.random() * 4) + "s";

            document.body.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 7000);

        }, i * 70);
    }
}


/* CONFETTI */
function confetti(){

    for(let i = 0; i < 180; i++){

        const piece = document.createElement("div");

        piece.style.position = "fixed";
        piece.style.width = "10px";
        piece.style.height = "10px";

        piece.style.background = `hsl(${Math.random() * 360},100%,60%)`;

        piece.style.left = Math.random() * 100 + "vw";
        piece.style.top = "-20px";

        piece.style.zIndex = "6000";

        document.body.appendChild(piece);

        const duration = 2000 + Math.random() * 3000;

        piece.animate(
            [
                { transform:"translateY(0)" },
                {
                    transform:`translateY(110vh) rotate(${Math.random() * 720}deg)`
                }
            ],
            {
                duration:duration
            }
        );

        setTimeout(() => {
            piece.remove();
        }, duration);
    }
}


/* FIREWORKS */
function fireworks(){

    for(let i = 0; i < 80; i++){

        const fire = document.createElement("div");

        fire.innerHTML = "✨";

        fire.style.position = "fixed";

        fire.style.left = Math.random() * 100 + "vw";
        fire.style.top = Math.random() * 80 + "vh";

        fire.style.fontSize = (20 + Math.random() * 35) + "px";

        fire.style.zIndex = "5000";

        document.body.appendChild(fire);

        fire.animate(
            [
                {
                    transform:"scale(0)",
                    opacity:0
                },
                {
                    transform:"scale(2)",
                    opacity:1
                },
                {
                    transform:"scale(0)",
                    opacity:0
                }
            ],
            {
                duration:1500 + Math.random() * 1000
            }
        );

        setTimeout(() => {
            fire.remove();
        }, 2500);
    }
}


/* MUSIC */
function toggleMusic(){

    const music = document.getElementById("music");

    if(music.paused){
        music.play();
    }else{
        music.pause();
    }
}

</script>

</body>
</html>